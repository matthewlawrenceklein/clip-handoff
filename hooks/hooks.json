{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/emit-protocol\"",
            "timeout": 5,
            "statusMessage": "Loading command handoff protocol..."
          }
        ]
      }
    ]
  }
}
